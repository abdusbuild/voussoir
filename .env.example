# Contact form (src/app/contact/actions.ts) sends through Resend — https://resend.com
# Without these, dev logs enquiries to the terminal; production shows an error.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Voussoir Website <website@voussoir.in>"
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries (defaults to info@voussoir.in)
CONTACT_TO_EMAIL=info@voussoir.in

# Canonical origin for metadata, sitemap and structured data (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://voussoir.in
